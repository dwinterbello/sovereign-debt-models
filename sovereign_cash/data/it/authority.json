  "elasticities": {
    "tax_rev": {
      "driver": "ngdp",
      "beta": 0.55,
      "clip": "PRE-support max |NGDP YoY| on clean PRE origins (~2.5pp)",
      "rule": "smly × (1 + 0.55 × clip(NGDP YoY_{t−1})); retune 2026-10-20e — PRE +6.4% / OOS −8.6% vs prod"
    },
    "primary": {
      "driver": "cpi",
      "beta": 0.35,
      "rule": "smly × (1 + 0.35 × HICP YoY_{t−1}); CPI unclipped"
    },
    "interest": {
      "driver": null,
      "rule": "smly — stock×rate (debt_country_annual × eff-rate OLS on macro rates) PRE −11%; SARIMAX+rates alone PRE 4.9%; with PRE-scaled treasury both sx and smly clear PRE; smly preferred (lower OOS)"
    },
    "other_rev": {
      "driver": null,
      "rule": "smly — DFP other current receipts have no single determinant; transfers/EU volatile"
    },
    "cap_exp": {
      "driver": "ngdp",
      "beta": 0.2,
      "clip": "same PRE-support NGDP clip as tax",
      "rule": "smly × (1 + 0.2 × clip(NGDP YoY_{t−1})); DFP_SHARE=False (share path OOS disaster)"
    },
    "treasury_bal": {
      "driver": null,
      "scale": 0.94,
      "rule": "smly × 0.94 — no DFP/MEF published treasury path; partite finanziarie ≠ BdI treasury_bal"
    }
  },
